---
import Base from "../layouts/Base.astro";
import Banner from "../components/Banner.astro";
import data, { href, displayMarketOutcome } from "../lib/data";

const rows = data.markets.map((m: any) => {
  const latest = m.versions.find((v: any) => v.version === m.latestVersion);
  const attempts = latest.outcome?.attempts ?? [];
  const shown = displayMarketOutcome(latest.outcome);
  return { m, latest, attempts: attempts.length, qualifying: attempts.filter((a: any) => a.qualifying).length, shown };
});
---
<Base title="AI Safety Claims" description="Dated research questions on AI alignment with frozen bars, and the published attempts scored against them.">
  <h1>AI Safety Claims</h1>
  <p>
    A registry of hard, dated research questions about AI alignment. Each question has a frozen contract: the bar
    a published method must meet by a deadline. Attempts are scored against it, and each market resolves
    {" "}<span class="YES">YES</span> (a qualifying attempt met the bars), <span class="NO">NO</span> (every
    qualifying attempt missed) or <span class="OTHER">OTHER</span> (no qualifying attempt).
  </p>
  <Banner />

  <h2>Markets</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th class="num">#</th><th>Question</th><th>Contract</th><th>Resolve by</th><th class="num">Attempts</th><th class="num">Qualifying</th><th>Outcome</th></tr></thead>
      <tbody>
        {rows.map(({ m, latest, attempts, qualifying, shown }: any) => (
          <tr>
            <td class="num">{m.number}</td>
            <td><a href={href(`markets/${m.market}/`)}>{m.title}</a></td>
            <td class="num">v{latest.version} <span class={`badge ${latest.status}`}>{latest.status}</span></td>
            <td class="num">{latest.resolveBy}</td>
            <td class="num">{attempts}</td>
            <td class="num">{qualifying}</td>
            <td class={shown.className}>{shown.label}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="muted">
    Market 14 (deployment criteria are binding) is not in the registry: its evidence is a few public documents, so it
    is listed directly as a YES/NO question. Before the filing window closes, <span class="OPEN">Open</span> means no
    qualifying attempts yet (the outcome file still reads OTHER).
  </p>

  <div class="cta">
    <p>
      <strong>Building an AI safety eval?</strong> Bring a prototype or a link to existing work. The registry shows which
      open research question it informs, what your run already establishes, and which frozen requirements it still
      misses. Early pilots are welcome; they do not have to qualify.
    </p>
    <a class="cta-button" href={href("contribute/")}>Contributors</a>
  </div>
</Base>
